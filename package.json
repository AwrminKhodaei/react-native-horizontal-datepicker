{
  "name": "@awrminkhodaei/react-native-horizontal-datepicker",
  "version": "1.0.0",
  "description": "horizontal datepicker for react-native",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/src/index.d.ts",
  "react-native": "src/index",
  "source": "src/index",
  "files": [
    "src",
    "lib",
    "!lib/typescript/example",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__"
  ],
  "scripts": {
    "test": "TZ=America/New_York jest",
    "typescript": "tsc --noEmit",
    "lint": "eslint .",
    "build": "bob build",
    "prepare": "husky && bob build",
    "release": "release-it",
    "example": "yarn --cwd example",
    "bootstrap": "yarn example && yarn"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": "https://github.com/AwrminKhodaei/react-native-horizontal-datepicker",
  "author": "awrminkhodaei <awrminkhodaei@gmail.com> (https://github.com/AwrminKhodaei)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AwrminKhodaei/react-native-horizontal-datepicker/issues"
  },
  "homepage": "https://github.com/AwrminKhodaei/react-native-horizontal-datepicker#readme",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.4",
    "@babel/runtime": "^7.25.6",
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/js": "^9.10.0",
    "@react-native/babel-preset": "0.74.87",
    "@release-it/conventional-changelog": "^12.0.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^18.3.5",
    "@types/react-test-renderer": "^18.3.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.36.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-builder-bob": "^0.30.2",
    "react-test-renderer": "18.2.0",
    "release-it": "^21.0.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-native": ">=0.60.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": "angular"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "moment-jalaali": "^0.9.2",
    "@types/moment-jalaali": "^0.7.4"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      "typescript"
    ]
  }
}
